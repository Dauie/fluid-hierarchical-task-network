<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style test project for net10.0 (Dauie/numun#283, fix 4). MSTest stays on 3.x,
       because MSTest 4 removed [ExpectedException], which 24 upstream tests use. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Fluid_HTN.UnitTests</RootNamespace>
    <AssemblyName>Fluid-HTN.UnitTests</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Properties/AssemblyInfo.cs holds the upstream assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- MSTEST0006 asks for Assert.ThrowsExactly. The upstream tests keep [ExpectedException]. -->
    <NoWarn>$(NoWarn);MSTEST0006</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.11.1" />
    <PackageReference Include="MSTest.TestFramework" Version="3.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fluid-HTN\Fluid-HTN.csproj" />
  </ItemGroup>

</Project>
