<Project Sdk="Microsoft.NET.Sdk">

  <!-- SDK-style project for net10.0 (Dauie/numun#283, fix 4). Nullable stays off:
       the upstream source has no nullable annotations. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FluidHTN</RootNamespace>
    <AssemblyName>Fluid-HTN</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <!-- Properties/AssemblyInfo.cs holds the upstream assembly attributes. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="package.json;Fluid.HTN.asmdef;**/*.meta" />
  </ItemGroup>

</Project>
